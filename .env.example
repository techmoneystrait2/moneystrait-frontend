# Copy to .env.local for local work. Keep values blank here; never commit real ones.
# Production values live in the host's secret store.

# Server side only
# Where /api is forwarded, for example the local Express URL.
BACKEND_URL=
CMS_API_TOKEN=

# Public: NEXT_PUBLIC_ values reach every browser, so never put a secret here
# Google OAuth client ID. It is public by design. The same value goes in the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_SENTRY_DSN=
